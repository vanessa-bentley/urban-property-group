{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-07-13",
	"compatibility_flags": [
		"global_fetch_strictly_public"
	],
	"name": "urban-property-group",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"kv_namespaces": [
	{
		"binding": "SESSION",
		"id": "8c7f00c74bb74686bfb53323aa28224d"
	}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "urban-property-leads",
			"database_id": "1ce4e737-b321-4533-bca6-5c40568f7fb7"
		}
	]
}