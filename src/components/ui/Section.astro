---
import Container from "./Container.astro";

interface Props {
    title: string;
    subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="py-20">

    <Container>

        <div class="mb-12 text-center">

            <h2 class="text-4xl font-bold text-slate-900">
                {title}
            </h2>

            {subtitle &&
                <p class="mx-auto mt-4 max-w-2xl text-lg text-slate-600">
                    {subtitle}
                </p>
            }

        </div>

        <slot />

    </Container>

</section>