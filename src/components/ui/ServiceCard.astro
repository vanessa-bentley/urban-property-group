---
import type { LucideIcon } from "lucide-astro";

interface Props {
  icon: LucideIcon;
  title: string;
  description: string;
}

const {
  icon: Icon,
  title,
  description,
} = Astro.props;
---

<div
  class="rounded-2xl border border-border bg-surface p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg"
>
  <div
    class="mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-brand/10"
  >
    <Icon class="h-7 w-7 text-brand" />
  </div>

  <h3 class="text-xl font-semibold text-heading">
    {title}
  </h3>

  <p class="mt-3 leading-7 text-body">
    {description}
  </p>
</div>