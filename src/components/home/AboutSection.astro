---
import Container from "../ui/Container.astro";
---

<section class="py-20 bg-slate-50">

  <Container>

    <div class="grid items-center gap-12 lg:grid-cols-2">

      <div>
        <h2 class="text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
          Property management built on trust and attention to detail
        </h2>

        <p class="mt-6 text-lg leading-8 text-slate-600">
          Urban Property Group was founded with a simple goal:
          provide property owners with reliable management,
          clear communication, and the confidence that their
          investment is being cared for.
        </p>

        <p class="mt-4 text-lg leading-8 text-slate-600">
          By combining local Utah knowledge with organized
          systems and modern technology, we create a better
          experience for both owners and tenants.
        </p>
      </div>


      <div>
        <img
          src="/images/vanessa.jpg"
          alt="Vanessa, founder of Urban Property Group"
          class="rounded-2xl shadow-lg"
        />
      </div>

    </div>

  </Container>

</section>