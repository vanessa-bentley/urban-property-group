---
import Container from "../ui/Container.astro";
---

<section class="bg-slate-900 py-20">

  <Container>

    <div class="text-center">

      <h2 class="text-3xl font-bold text-white sm:text-4xl">
        Ready to simplify your property management?
      </h2>

      <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-slate-300">
        Whether you need help finding reliable tenants,
        managing day-to-day operations, or protecting your
        investment, Urban Property Group is here to help.
      </p>

      <div class="mt-8">
        <a
          href="/contact"
          class="inline-flex items-center rounded-xl bg-white px-6 py-3 font-semibold text-slate-900 transition hover:bg-slate-100"
        >
          Request a Consultation
        </a>
      </div>

    </div>

  </Container>

</section>