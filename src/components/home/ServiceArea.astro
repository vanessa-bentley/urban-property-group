---
import Container from "../ui/Container.astro";
---

<section class="py-20">

  <Container>

    <div class="text-center">

      <h2 class="text-3xl font-bold text-slate-900 sm:text-4xl">
        Serving Northern Utah Property Owners
      </h2>

      <p class="mx-auto mt-4 max-w-3xl text-lg leading-8 text-slate-600">
        Urban Property Group provides professional property
        management services throughout the Salt Lake Valley
        and surrounding areas.
      </p>

    </div>


    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">

      <div class="rounded-xl bg-slate-50 p-6 text-center">
        <h3 class="font-semibold text-slate-900">
          Salt Lake City
        </h3>
      </div>


      <div class="rounded-xl bg-slate-50 p-6 text-center">
        <h3 class="font-semibold text-slate-900">
          Holladay
        </h3>
      </div>


      <div class="rounded-xl bg-slate-50 p-6 text-center">
        <h3 class="font-semibold text-slate-900">
          Millcreek
        </h3>
      </div>


      <div class="rounded-xl bg-slate-50 p-6 text-center">
        <h3 class="font-semibold text-slate-900">
          Davis County
        </h3>
      </div>

    </div>

  </Container>

</section>