---
import Container from "../ui/Container.astro";
---

<section class="pt-8 pb-24">

  <Container>

    <div class="grid items-center gap-16 lg:grid-cols-2">

      <!-- Left Side -->
      <div>

        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-brand-light">
          Northern Utah Property Management
        </p>

        <h1 class="text-5xl font-bold leading-tight text-heading lg:text-6xl">
          Property Management,
          <br />
          Done Personally.
        </h1>

        <p class="mt-8 max-w-xl text-lg leading-8 text-body">
          We help Northern Utah rental property owners protect
          their investments through organized systems,
          responsive communication, and thoughtful property
          management.
        </p>

        <div class="mt-10 flex flex-wrap gap-4">

          <a
            href="/contact"
              class="rounded-xl border border-brand px-6 py-3 font-semibold text-brand transition-colors duration-200 hover:bg-brand-light hover:text-white"
          >
            Schedule a Consultation
          </a>

          <a
            href="/services"
              class="rounded-xl bg-heading px-7 py-3.5 text-white transition-colors duration-200 hover:bg-brand"
          >
            Our Services
          </a>

        </div>

      </div>

      <!-- Right Side -->

      <div class="relative">

        <img
          src="/images/hero-home.jpg"
          alt="Beautiful Utah home"
          class="relative rounded-3xl shadow-xl"
        />

      </div>

    </div>

  </Container>

</section>