---
import Container from "../ui/Container.astro";
---
<section class="pb-24">
  <Container>
    <div class="grid gap-16 lg:grid-cols-2">
      <!-- Left Column -->
      <div>
        <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-brand-light">
          Get in Touch
        </p>
        <h2 class="text-4xl font-bold text-heading">
          We'd Love to Hear From You
        </h2>
        <p class="mt-6 leading-8 text-body">
          Whether you own a single rental home or a growing investment
          portfolio, we're happy to answer your questions and discuss how
          Urban Property Group can help.
        </p>
        <div class="mt-10 space-y-6">
          <div class="flex gap-4">
            <div class="mt-1 h-3 w-3 rounded-full bg-brand"></div>
            <div>
              <h3 class="font-semibold text-heading">
                Personalized Service
              </h3>
              <p class="text-body">
                Every property receives the attention it deserves.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="mt-1 h-3 w-3 rounded-full bg-brand"></div>
            <div>
              <h3 class="font-semibold text-heading">
                Local Expertise
              </h3>
              <p class="text-body">
                Proudly serving Northern Utah property owners.
              </p>
            </div>
          </div>
          <div class="flex gap-4">
            <div class="mt-1 h-3 w-3 rounded-full bg-brand"></div>
            <div>
              <h3 class="font-semibold text-heading">
                Responsive Communication
              </h3>
              <p class="text-body">
                Clear updates and prompt responses every step of the way.
              </p>
            </div>
          </div>
        </div>
      </div>
      <!-- Right Column -->
      <div class="rounded-3xl border border-border bg-surface p-8 shadow-sm">
        <!-- Form -->
        <form id="contact-form" class="space-y-6">
          <div>
            <label class="mb-2 block font-medium text-heading">
              Name
            </label>
            <input
              name="name"
              type="text"
              required
              class="w-full rounded-xl border border-border px-4 py-3 focus:border-brand focus:outline-none"
            />
          </div>
          <div>
            <label class="mb-2 block font-medium text-heading">
              Email
            </label>
            <input
              name="email"
              type="email"
              required
              class="w-full rounded-xl border border-border px-4 py-3 focus:border-brand focus:outline-none"
            />
          </div>
          <div>
            <label class="mb-2 block font-medium text-heading">
              Phone
            </label>
            <input
              name="phone"
              type="tel"
              class="w-full rounded-xl border border-border px-4 py-3 focus:border-brand focus:outline-none"
            />
          </div>
          <div>
            <label class="mb-2 block font-medium text-heading">
              Property Address <span class="text-body">(Optional)</span>
            </label>
            <input
              name="property_address"
              type="text"
              class="w-full rounded-xl border border-border px-4 py-3 focus:border-brand focus:outline-none"
            />
          </div>
          <div>
            <label class="mb-2 block font-medium text-heading">
              Message
            </label>
            <textarea
              name="message"
              rows="5"
              class="w-full rounded-xl border border-border px-4 py-3 focus:border-brand focus:outline-none"
            ></textarea>
          </div>
          <button
            id="submit-button"
            type="submit"
            class="w-full rounded-xl bg-heading px-7 py-3.5 text-white transition-colors duration-200 hover:bg-brand"
          >
            Schedule a Consultation
          </button>
        </form>
        <!-- Success Message -->
        <div
          id="success-message"
          class="hidden text-center"
        >
          <div class="mx-auto flex h-16 w-16 items-center justify-center rounded-full bg-brand/10 text-3xl text-brand">
            ✓
          </div>
          <h3 class="mt-6 text-2xl font-semibold text-heading">
            Thank You!
          </h3>
          <p class="mt-4 leading-7 text-body">
            We received your inquiry and will be in touch within one business day.
          </p>
        </div>
      </div>
    </div>
  </Container>
</section>
<script>
  const form = document.getElementById("contact-form");
  const successMessage = document.getElementById("success-message");
  const button = document.getElementById("submit-button");
  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const formElement = form as HTMLFormElement;
    const formData = new FormData(formElement);
    const data = Object.fromEntries(formData.entries());
    button!.textContent = "Sending...";
    button!.setAttribute("disabled", "true");
    try {
      const response = await fetch("/api/contact", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify(data),
      });
      if (!response.ok) {
        throw new Error("Submission failed");
      }
      formElement.classList.add("hidden");
      successMessage?.classList.remove("hidden");
    } catch (error) {
      button!.textContent = "Try Again";
      button!.removeAttribute("disabled");
    }
  });
</script>