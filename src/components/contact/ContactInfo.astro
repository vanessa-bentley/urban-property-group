---
import Container from "../ui/Container.astro";
import { MapPinned, Mail, Clock3 } from "lucide-astro";
---

<section class="pb-24">

  <Container>

    <div class="text-center">

      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-brand-light">
        Contact Information
      </p>

      <h2 class="text-4xl font-bold text-heading">
        We're Here to Help
      </h2>

      <p class="mx-auto mt-6 max-w-2xl text-lg leading-8 text-body">
        Have questions before getting started? Reach out anytime.
        We'd be happy to discuss your property and answer any questions.
      </p>

    </div>

    <div class="mt-16 grid gap-8 md:grid-cols-3">

      <!-- Service Area -->

      <div class="rounded-2xl border border-border bg-surface p-8 text-center shadow-sm">

        <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-brand/10">
          <MapPinned class="h-7 w-7 text-brand" />
        </div>

        <h3 class="text-xl font-semibold text-heading">
          Service Area
        </h3>

        <p class="mt-4 leading-7 text-body">
          Proudly serving property owners throughout
          Northern Utah, including Salt Lake, Davis,
          and surrounding communities.
        </p>

      </div>

      <!-- Email -->

      <div class="rounded-2xl border border-border bg-surface p-8 text-center shadow-sm">

        <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-brand/10">
          <Mail class="h-7 w-7 text-brand" />
        </div>

        <h3 class="text-xl font-semibold text-heading">
          Email
        </h3>

        <p class="mt-4 leading-7 text-body">
          info@urbanpropertygroup.com
        </p>

      </div>

      <!-- Response Time -->

      <div class="rounded-2xl border border-border bg-surface p-8 text-center shadow-sm">

        <div class="mx-auto mb-6 flex h-14 w-14 items-center justify-center rounded-full bg-brand/10">
          <Clock3 class="h-7 w-7 text-brand" />
        </div>

        <h3 class="text-xl font-semibold text-heading">
          Response Time
        </h3>

        <p class="mt-4 leading-7 text-body">
          We strive to respond to all inquiries within
          one business day.
        </p>

      </div>

    </div>

  </Container>

</section>