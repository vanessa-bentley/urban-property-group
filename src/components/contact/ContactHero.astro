---
import Container from "../ui/Container.astro";
---

<section class="pt-10 pb-20 lg:pt-14 lg:pb-24">

  <Container>

    <div class="mx-auto max-w-3xl text-center">

      <p class="mb-4 text-sm font-semibold uppercase tracking-[0.25em] text-brand-light">
        Contact Urban Property Group
      </p>

      <h1 class="text-5xl font-bold leading-tight text-heading lg:text-6xl">
        Let's Talk About
        <br />
        Your Property
      </h1>

      <p class="mx-auto mt-8 max-w-2xl text-lg leading-8 text-body">
        Whether you're looking for full-service property management or
        simply have questions about renting your home, we're here to help.
        We'd love to learn more about your property and discuss how we can
        help protect your investment.
      </p>

    </div>

  </Container>

</section>