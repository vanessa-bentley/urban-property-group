---
import WhyChooseUs from "../components/home/WhyChooseUs.astro";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/home/Hero.astro";
import Section from "../components/ui/Section.astro";
import ServiceCard from "../components/ui/ServiceCard.astro";
import AboutSection from "../components/home/AboutSection.astro";
import ServiceArea from "../components/home/ServiceArea.astro";
import CTA from "../components/home/CTA.astro";
import {
  Users,
  HandCoins,
  Wrench,
  ClipboardCheck,
} from "lucide-astro";
---

<Layout title="Urban Property Group">

  <Hero />

  <WhyChooseUs />
  
  <Section
    title="Our Services"
    subtitle="Comprehensive property management designed to protect your investment."
  >
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">

      <ServiceCard
		icon={Users}
		title="Tenant Placement"
		description="Marketing, showings, and thorough tenant screening."
		/>

	 <ServiceCard
		icon={HandCoins}
		title="Rent Collection"
		description="Reliable rent collection and owner distributions."
		/>

	 <ServiceCard
		icon={Wrench}
		title="Maintenance"
		description="Coordinating repairs with trusted vendors."
		/>

	 <ServiceCard
		icon={ClipboardCheck}
		title="Inspections"
		description="Routine inspections to protect your property."
		/>

    </div>
    </Section>


<AboutSection />

<ServiceArea />

<CTA />

</Layout>

</Layout>